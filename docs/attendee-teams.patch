diff --git a/bots/bot_controller/partial_caption_webhook_sender.py b/bots/bot_controller/partial_caption_webhook_sender.py
new file mode 100644
index 0000000..03434ca
--- /dev/null
+++ b/bots/bot_controller/partial_caption_webhook_sender.py
@@ -0,0 +1,119 @@
+import logging
+import os
+import threading
+import time
+import uuid
+from collections import OrderedDict
+
+import requests
+from django.conf import settings
+
+from bots.models import WebhookTriggerTypes
+from bots.webhook_utils import sign_payload, url_is_public
+
+logger = logging.getLogger(__name__)
+
+PARTIAL_WEBHOOK_REQUEST_TIMEOUT = float(os.getenv("PARTIAL_CAPTION_WEBHOOK_REQUEST_TIMEOUT", 5))
+
+
+class PartialCaptionWebhookSender:
+    """
+    Sends every change of a running closed caption (partial and final) to the bot's transcript.partial
+    webhook subscribers, straight from the bot process.
+
+    Unlike other webhooks these are not stored as WebhookDeliveryAttempt rows and are not retried: they
+    arrive several times a second, are only useful right away, and the finished caption still arrives
+    as transcript.update. One background thread posts them in order; while a post is in flight, newer
+    updates of the same caption replace the queued one, so a slow receiver gets the latest text, not a backlog.
+    """
+
+    def __init__(self, bot):
+        # Runs on the main thread: all database reads happen here.
+        trigger = WebhookTriggerTypes.TRANSCRIPT_PARTIAL
+        if bot.bot_webhook_subscriptions.exists():
+            subscriptions = bot.bot_webhook_subscriptions.filter(triggers__contains=[trigger], is_active=True)
+        else:
+            subscriptions = bot.project.webhook_subscriptions.filter(bot__isnull=True, triggers__contains=[trigger], is_active=True)
+        self.urls = [s.url for s in subscriptions if not settings.REQUIRE_PUBLIC_WEBHOOK_URLS or url_is_public(s.url)]
+        self.secret = None
+        if self.urls:
+            active_secret = bot.project.webhook_secrets.order_by("-created_at").first()
+            self.secret = active_secret.get_secret() if active_secret else None
+        self.bot_id = bot.object_id
+        self.bot_metadata = bot.metadata
+        self.pending = OrderedDict()  # caption key -> latest payload not yet sent
+        self.last_sent = {}  # caption key -> (text, is_final) last queued, to skip repeats
+        self.seq = {}
+        self.cond = threading.Condition()
+        self.thread = None
+        self.last_error_logged_at = 0.0
+
+    def enabled(self):
+        return bool(self.urls and self.secret)
+
+    def caption_updated(self, *, caption_data, participant, timestamp_ms):
+        """Called for every caption update. timestamp_ms matches the transcript.update of the finished caption."""
+        if not self.enabled() or not participant:
+            return
+        key = f"{caption_data['deviceId']}:{caption_data['captionId']}"
+        text = caption_data.get("text", "")
+        is_final = bool(caption_data.get("isFinal"))
+        if self.last_sent.get(key) == (text, is_final):
+            return
+        self.last_sent[key] = (text, is_final)
+        self.seq[key] = self.seq.get(key, 0) + 1
+        data = {
+            "caption_id": key,
+            "seq": self.seq[key],
+            "speaker_name": participant.get("participant_full_name"),
+            "speaker_uuid": participant.get("participant_uuid"),
+            "speaker_user_uuid": participant.get("participant_user_uuid"),
+            "speaker_is_host": participant.get("participant_is_host", False),
+            "timestamp_ms": timestamp_ms,
+            "text": text,
+            "is_final": is_final,
+        }
+        with self.cond:
+            self.pending[key] = data
+            self.pending.move_to_end(key)
+            if self.thread is None:
+                self.thread = threading.Thread(target=self._run, name="partial-caption-webhooks", daemon=True)
+                self.thread.start()
+            self.cond.notify()
+
+    def _run(self):
+        while True:
+            with self.cond:
+                while not self.pending:
+                    self.cond.wait()
+                _, data = self.pending.popitem(last=False)
+            self._post(data)
+
+    def _post(self, data):
+        payload = {
+            "idempotency_key": str(uuid.uuid4()),
+            "bot_id": self.bot_id,
+            "bot_metadata": self.bot_metadata,
+            "trigger": WebhookTriggerTypes.trigger_type_to_api_code(WebhookTriggerTypes.TRANSCRIPT_PARTIAL),
+            "data": data,
+        }
+        headers = {"Content-Type": "application/json", "User-Agent": "Attendee-Webhook/1.0", "X-Webhook-Signature": sign_payload(payload, self.secret)}
+        for url in self.urls:
+            try:
+                response = requests.post(
+                    url,
+                    json=payload,
+                    headers=headers,
+                    timeout=PARTIAL_WEBHOOK_REQUEST_TIMEOUT,
+                    verify=os.getenv("DELIVER_WEBHOOK_VERIFY_SSL", "true").lower() != "false",
+                    allow_redirects=False,
+                )
+                if not 200 <= response.status_code < 300:
+                    self._log_error(f"partial caption webhook to {url} returned {response.status_code}")
+            except requests.RequestException as e:
+                self._log_error(f"partial caption webhook to {url} failed: {e}")
+
+    def _log_error(self, message):
+        if time.time() - self.last_error_logged_at > 60:
+            logger.warning(message)
+            self.last_error_logged_at = time.time()
