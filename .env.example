# Live Whiteboard configuration. Copy to .env and fill in the keys:  cp .env.example .env
# Values below are the defaults. Variables already set in the shell win over this file.

# ----------------------------------------------------------------- API keys
ANTHROPIC_API_KEY=              # modeller, consolidator, analyst (+ extractor with LW_EXTRACTOR_BACKEND=claude)
OPENAI_API_KEY=                 # talk-live speech-to-text and scripts/make_test_audio.py
JEV_API_KEY=                    # extractor (default backend jev); not needed with LW_EXTRACTOR_BACKEND=claude

# ----------------------------------------------------------------- Agents
LW_MODEL=claude-sonnet-5-5      # default model for every agent

# Extractor: classifies each utterance. Backend: jev (TypeSafe Jev classifier, ~0.25 s) | claude (~1-2 s,
# also rewrites utterances into clean claims). Effort/thinking/model below apply to claude only.
LW_EXTRACTOR_BACKEND=jev
LW_EXTRACTOR_EFFORT=low         # low | medium | high
LW_EXTRACTOR_THINKING=adaptive  # adaptive | disabled (Haiku) | between_tools (Sonnet)
# LW_EXTRACTOR_MODEL=           # default: LW_MODEL
LW_JEV_MODEL=jev-latest

# Modeller: edits the board per utterance (live path). Haiku + disabled thinking is faster
# but leaves placeholders and duplicates on live speech; keep Sonnet + adaptive for talk live.
LW_MODELLER_EFFORT=low
LW_MODELLER_THINKING=adaptive
# LW_MODELLER_MODEL=            # default: LW_MODEL

# Consolidator: background cleanup pass (duplicates, placeholders, groups, loose nodes).
LW_CONSOLIDATE_EVERY=4          # meaningful utterances between passes; 0 = off (also no final pass)
LW_CONSOLIDATOR_EFFORT=medium
LW_CONSOLIDATOR_THINKING=adaptive
# LW_CONSOLIDATOR_MODEL=        # default: LW_MODEL
LW_LAYOUT_HINTS=1               # 1: the consolidator also returns a layout plan (story order, direction,
                                # placements) that Tidy follows; 0: graph-only layout (for comparison)

# Custom vocabulary: product names speech-to-text mishears ("Geoff classifier" -> JEV classifier), fixed in the
# transcript and listed in the agents' prompts. A JSON file {correct: [misheard, ...]}; missing file = off.
# LW_VOCABULARY=data/vocabulary.json

# Analyst: open questions and disagreements.
LW_ANALYST_EFFORT=low

# Approval mode at server start (switchable in the UI): auto = agents edit freely,
# ask = removing a node waits for someone to approve it.
LW_APPROVAL_MODE=auto

# Feedback button: opens the team's anonymous Microsoft Form by default. Another link replaces it; empty hides the button.
# LW_FEEDBACK_URL=https://forms.cloud.microsoft/...

# Rooms: every visitor gets their own board (?room=<id>). At most this many rooms at once (the default room,
# used without ?room=, is extra); a room with no one connected and nothing running is dropped after 30 min.
LW_MAX_ROOMS=20

# ----------------------------------------------------------------- Talk live (speech-to-text)
LW_STT_MODEL=gpt-live-transcribe
LW_STT_SEGMENTATION=            # local | server; empty = picked from the model (local for gpt-live-transcribe)
LW_STT_LANGUAGE=en
LW_STT_NOISE_REDUCTION=far_field  # far_field | near_field | none
LW_VAD_SILENCE_MS=700           # pause that ends an utterance
LW_VAD_MIN_RMS=220              # minimum loudness counted as speech (local segmentation)
LW_MIC_CHUNK_WORDS=6            # a segment goes to the agents every this many words while you talk (or at a sentence end)
LW_MIC_PAUSE_S=0.8              # ... or after this long without new text

# ----------------------------------------------------------------- Teams meeting (self-hosted Attendee bot)
# See docs/TEAMS.md. A bot joins the Teams call; its webhooks carry who said what.
ATTENDEE_URL=http://localhost:8000      # your Attendee server
ATTENDEE_API_KEY=                       # Attendee dashboard, Settings, API Keys
ATTENDEE_WEBHOOK_SECRET=                # Attendee dashboard, Settings, Webhooks (base64, used to verify signatures)
LW_PUBLIC_URL=http://host.docker.internal:8010  # how Attendee reaches THIS app; it posts webhooks to <LW_PUBLIC_URL>/api/attendee/webhook
                                        # this default: Attendee in Docker on the same laptop (needs REQUIRE_HTTPS_WEBHOOKS=false
                                        # in Attendee's .env); Attendee elsewhere: the https URL of a cloudflared/ngrok tunnel
LW_ATTENDEE_BOT_NAME=Shape The Talk Bot # name the bot shows in the meeting (it is left out of the participants)
LW_ATTENDEE_TRANSCRIPTION=captions      # captions: Teams closed captions (free, low latency, lower quality)
                                        # openai:   OpenAI transcription via Attendee (needs an OpenAI key in the Attendee dashboard)
LW_TEAMS_CHUNK_WORDS=6                  # captions + docs/attendee-teams.patch: a running caption goes to the agents every this
                                        # many stable words, mid-sentence too (or at a sentence end), not only when Teams finalizes it
LW_TEAMS_PAUSE_S=0.8                    # ... or after this long without a caption update (a short pause)
LW_TEAMS_START_PAUSED=1                 # 1: the bot joins paused and hears nothing until you press Resume; 0: listens at once
# ATTENDEE_TEAMS_LANGUAGE=              # captions language for everyone in the meeting, e.g. en-us (default: the meeting's)
LW_ATTENDEE_INTRO=1                     # whether "Say hi in the meeting chat" starts ticked on the page (1) or not (0);
                                        # a browser keeps its own last choice
# LW_ATTENDEE_INTRO_TEXT=               # the intro text, {bot_name} is the bot's name (no emojis: Attendee can't type them)
ATTENDEE_TEAMS_LOGIN=0                  # 1: the bot signs in with the Teams bot login set up in Attendee (see its signed-in bots guide)
